# ==========================================
# VELOURA - Environment Variables Template
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real ".env" file to GitHub.
# ==========================================

# MongoDB connection string
# Example (local):  mongodb://127.0.0.1:27017/veloura
# Example (Atlas):   mongodb+srv://<user>:<password>@cluster.mongodb.net/veloura
MONGODB_URI=

# Secret key used to sign JWT tokens (use any long random string)
JWT_SECRET=

# JWT token expiry (optional, defaults to 7d if not set)
JWT_EXPIRES_IN=7d

# Razorpay credentials (leave empty if you don't have a Razorpay account yet)
# The app will detect missing keys and clearly disable live payments instead of faking success.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server port
PORT=5000

# Node environment
NODE_ENV=development
